execute_process(COMMAND "${CLANG}" --target=aarch64-linux-android26 -c "${SOURCE}" -o "${OBJECT}" RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "ARM64 shim assembly failed: ${error}")
endif()
execute_process(COMMAND "${READELF}" --eh-frame "${OBJECT}" OUTPUT_VARIABLE frames RESULT_VARIABLE status)
if(NOT status EQUAL 0 OR NOT frames MATCHES "800" OR NOT frames MATCHES "reg19|r19|W19")
    message(FATAL_ERROR "ARM64 CFI missing saved interpreter registers: ${frames}")
endif()
execute_process(COMMAND "${OBJDUMP}" -d "${OBJECT}" OUTPUT_VARIABLE disasm RESULT_VARIABLE status)
string(TOLOWER "${disasm}" disasm)
if(NOT status EQUAL 0 OR NOT disasm MATCHES "bti[ \t]+jc" OR NOT disasm MATCHES "fpsr" OR NOT disasm MATCHES "fpcr" OR NOT disasm MATCHES "nzcv")
    message(FATAL_ERROR "ARM64 landing/FP/condition state preservation missing")
endif()
